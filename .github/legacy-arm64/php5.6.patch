--- a/Dockerfile
+++ b/Dockerfile
@@ -1,5 +1,16 @@
 FROM php:5.6-fpm
 
+# Frozen base: its Debian suites are only on snapshot.debian.org now and stretch's archive keys have expired.
+# /etc/apt/snapshot.sha256 pins the release files to the copies verified against those keys as of the amd64 build
+# date; the next RUN checks what apt fetched against it, and apt checks every index and package against those files.
+RUN set -e; l=snapshot.debian.org_archive; \
+	printf '%s  %s\n' \
+		fe55c42941dd43102b9490af1678e7962ea1e257ccb8f942b43770475c336eb3 ${l}_debian_20230220T000000Z_dists_stretch_Release \
+		35b3294728144de605c0192e533ca97de6b77112b52d565566ab5ce7ef432a2c ${l}_debian_20230220T000000Z_dists_stretch-updates_Release \
+		cb3eb154bf0311d53c98eab79692e55aae49a4bcf13c23bd12943a4fb5a0b05f ${l}_debian-security_20230220T000000Z_dists_stretch_updates_Release \
+		> /etc/apt/snapshot.sha256; \
+	sed -i -E 's#^deb http://(deb|security)\.debian\.org/(debian-security|debian) #deb [trusted=yes] http://snapshot.debian.org/archive/\2/20230220T000000Z #' /etc/apt/sources.list
+
 LABEL maintainer="Riddhesh Sanghvi <riddhesh237@gmail.com>, Devarshi Sathiya <devarshisathiya5@gmail.com>"
 LABEL org.label-schema.schema-version="1.0.0-rc1"
 LABEL org.label-schema.vendor="EasyEngine"
@@ -7,6 +18,7 @@
 
 RUN set -ex; \
 	apt-get update; \
+	(cd /var/lib/apt/lists && sha256sum -c /etc/apt/snapshot.sha256); \
 	apt-get install -y --no-install-recommends \
 		imagemagick \
 		less \
@@ -27,7 +39,7 @@
 		vim \
 		zip
 
-RUN pecl install imagick memcached-2.2.0; \
+RUN pecl install imagick-3.7.0 memcached-2.2.0; \
 	printf "\n" | pecl install mcrypt-1.0.1; \
 	printf "\n" | pecl install redis; \
 	docker-php-ext-configure gd --with-png-dir=/usr --with-jpeg-dir=/usr; \
